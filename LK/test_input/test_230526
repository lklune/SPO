// вводим новые методы и переопределяем наследуемые
// в main порождаем экземпляры и передаем в функции, в выводе видно что вызывалось

interface A begin
    def x();
end

interface B begin
    def y();
end

interface C begin
    def z();
end

type T1 begin
    def m()
        println("T1::m");
    end
end

type T2 of T1 implements A begin
    def x()
        println("T2::x");
    end

    def m()
        println("T2::m");
    end
end

type T3 of T2 implements B begin
    def y()
        println("T3::y");
    end

    def m()
        println("T3::m");
    end
end

type T4 of T1 begin
    def m()
        println("T4::m");
    end
end

type T5 of T2 implements C begin
    def x()
        println("T5::x");
    end

    def z()
        println("T5::z");
    end

    def m()
        println("T5::m");
    end
end

type T6 implements C begin
    def z()
        println("T6::z");
    end

    def n()
        println("T6::n");
    end
end

type T7 of T6 begin
    def z()
        println("T7::z");
    end

    def n()
        println("T7::n");
    end
end

type T8 of T7 implements B begin
    def y()
        println("T8::y");
    end

    def z()
        println("T8::z");
    end

    def n()
        println("T8::n");
    end
end

////////////////////

def f1(a of A)
    a.x();
end

def f2(b of B)
    b.y();
end

def f3(c of C)
    c.z();
end

def f4(t of T1)
    t.m();
end

def f5(t of T6)
    t.n();
end

////////////////////////

def main()
    T2 t2;
    T3 t3;
    T4 t4;
    T5 t5;
    T6 t6;
    T7 t7;
    T8 t8;

    t2.x();
    t2.m();

    t3.x();
    t3.y();
    t3.m();

    t4.m();

    t5.x();
    t5.z();
    t5.m();

    t6.z();
    t6.n();

    t7.z();
    t7.n();

    t8.y();
    t8.z();
    t8.n();

    f1(t2);
    f1(t3);
    f1(t5);

    f2(t3);
    f2(t8);

    f3(t5);
    f3(t6);
    f3(t7);
    f3(t8);

    f4(t2);
    f4(t3);
    f4(t4);
    f4(t5);

    f5(t6);
    f5(t7);
    f5(t8);
end
